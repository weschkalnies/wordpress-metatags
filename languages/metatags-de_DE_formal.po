msgid ""
msgstr ""
"Project-Id-Version: Meta Tags 2.1.0\n"
"Language: de_DE_formal\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: metatags\n"

msgid "Meta Tags"
msgstr "Meta Tags"

msgid "Per-post meta title, description, robots, keywords, Open Graph and Twitter Card tags."
msgstr "Meta-Titel, Beschreibung, Robots, Keywords, Open-Graph- und Twitter-Card-Tags pro Beitrag."

msgid "Choose Open Graph image"
msgstr "Open-Graph-Bild wählen"

msgid "Use this image"
msgstr "Dieses Bild verwenden"

msgid "%1$d / %2$d characters"
msgstr "%1$d / %2$d Zeichen"

msgid "Title"
msgstr "Titel"

msgid "Description"
msgstr "Beschreibung"

msgid "Canonical URL"
msgstr "Kanonische URL"

msgid "Canonical"
msgstr "Kanonische URL"

msgid "Only needed if the canonical URL differs from the permalink."
msgstr "Nur nötig, wenn die kanonische URL vom Permalink abweicht."

msgid "Robots"
msgstr "Robots"

msgid "Discourage indexing (noindex)"
msgstr "Indexierung verhindern (noindex)"

msgid "Do not follow links (nofollow)"
msgstr "Links nicht folgen (nofollow)"

msgid "Discourage search engines from indexing this page (noindex)"
msgstr "Suchmaschinen daran hindern, diese Seite zu indexieren (noindex)"

msgid "Do not follow links on this page (nofollow)"
msgstr "Links auf dieser Seite nicht folgen (nofollow)"

msgid "Excluded from search engines and the XML sitemap."
msgstr "Von Suchmaschinen und der XML-Sitemap ausgeschlossen."

msgid "More directives"
msgstr "Weitere Anweisungen"

msgid "Optional, comma separated: noarchive, nosnippet, noimageindex, notranslate, max-snippet:N, max-image-preview:none|standard|large, max-video-preview:N."
msgstr "Optional, kommagetrennt: noarchive, nosnippet, noimageindex, notranslate, max-snippet:N, max-image-preview:none|standard|large, max-video-preview:N."

msgid "Keywords"
msgstr "Keywords"

msgid "Comma separated."
msgstr "Kommagetrennt."

msgid "Custom HTML"
msgstr "Eigenes HTML"

msgid "Printed as-is into &lt;head&gt;, e.g. <code>&lt;meta name=\"google-site-verification\" content=\"…\"&gt;</code>"
msgstr "Wird unverändert in den &lt;head&gt; geschrieben, z. B. <code>&lt;meta name=\"google-site-verification\" content=\"…\"&gt;</code>"

msgid "Only &lt;meta&gt; and &lt;link&gt; tags are allowed for your user role."
msgstr "Für Ihre Benutzerrolle sind nur &lt;meta&gt;- und &lt;link&gt;-Tags erlaubt."

msgid "Custom HTML can be edited in the Meta Tags box below the editor."
msgstr "Eigenes HTML kann in der Meta-Tags-Box unterhalb des Editors bearbeitet werden."

msgid "Search engines"
msgstr "Suchmaschinen"

msgid "Social media (Open Graph)"
msgstr "Social Media (Open Graph)"

msgid "Type"
msgstr "Typ"

msgid "e.g. <code>article</code>, <code>website</code>, <code>product</code>"
msgstr "z. B. <code>article</code>, <code>website</code>, <code>product</code>"

msgid "e.g. article, website, product"
msgstr "z. B. article, website, product"

msgid "URL"
msgstr "URL"

msgid "Only needed if it differs from the permalink."
msgstr "Nur nötig, wenn sie vom Permalink abweicht."

msgid "Site name"
msgstr "Seitenname"

msgid "All meta tags are switched off."
msgstr "Alle Meta-Tags sind ausgeschaltet."

msgid "Open settings"
msgstr "Einstellungen öffnen"

msgid "Grey placeholder text shows the value used automatically when a field is left empty."
msgstr "Der graue Platzhaltertext zeigt, welcher Wert automatisch verwendet wird, wenn ein Feld leer bleibt."

msgid "Image"
msgstr "Bild"

msgid "Open Graph image"
msgstr "Open-Graph-Bild"

msgid "Select image"
msgstr "Bild auswählen"

msgid "Remove"
msgstr "Entfernen"

msgid "Recommended: 1200 × 630 px. Without an image the featured image or default image is used."
msgstr "Empfohlen: 1200 × 630 px. Ohne Bild wird das Beitrags- oder Standardbild verwendet."

msgid "Recommended: 1200 × 630 px. Without an image the default image is used."
msgstr "Empfohlen: 1200 × 630 px. Ohne Bild wird das Standardbild verwendet."

msgid "Tags"
msgstr "Tags"

msgid "Behaviour"
msgstr "Verhalten"

msgid "Archives"
msgstr "Archive"

msgid "Replaces the document &lt;title&gt; with the custom title."
msgstr "Ersetzt den &lt;title&gt; der Seite durch den eigenen Titel."

msgid "Outputs &lt;meta name=\"description\"&gt;."
msgstr "Gibt &lt;meta name=\"description\"&gt; aus."

msgid "Overrides the canonical URL output by WordPress."
msgstr "Überschreibt die von WordPress ausgegebene kanonische URL."

msgid "Adds directives such as noindex to the robots meta tag generated by WordPress."
msgstr "Ergänzt Anweisungen wie noindex im Robots-Meta-Tag von WordPress."

msgid "Ignored by Google and Bing – only enable if you need it for another tool."
msgstr "Wird von Google und Bing ignoriert – nur aktivieren, wenn ein anderes Tool es braucht."

msgid "Open Graph"
msgstr "Open Graph"

msgid "og:* tags for Facebook, LinkedIn, Slack, WhatsApp, Mastodon …"
msgstr "og:*-Tags für Facebook, LinkedIn, Slack, WhatsApp, Mastodon …"

msgid "Twitter / X Card"
msgstr "Twitter-/X-Card"

msgid "twitter:card tag, uses the Open Graph values."
msgstr "twitter:card-Tag, nutzt die Open-Graph-Werte."

msgid "Structured data (JSON-LD)"
msgstr "Strukturierte Daten (JSON-LD)"

msgid "Outputs minimal Schema.org JSON-LD (WebSite, WebPage, Article) in &lt;head&gt;."
msgstr "Gibt minimales Schema.org JSON-LD (WebSite, WebPage, Article) im &lt;head&gt; aus."

msgid "Free-form HTML per post, printed into &lt;head&gt;."
msgstr "Freies HTML pro Beitrag, wird in den &lt;head&gt; geschrieben."

msgid "Automatic fallbacks"
msgstr "Automatische Fallbacks"

msgid "If a field is empty, use post title, excerpt, permalink, site name and featured image."
msgstr "Leere Felder mit Beitragstitel, Auszug, Permalink, Seitenname und Beitragsbild füllen."

msgid "Default Open Graph image"
msgstr "Standard-Open-Graph-Bild"

msgid "Recommended: 1200 × 630 px. Used on the front page, archives, and posts without an own or featured image."
msgstr "Empfohlen: 1200 × 630 px. Wird auf der Startseite, in Archiven und bei Beiträgen ohne eigenes oder Beitragsbild verwendet."

msgid "Twitter / X site handle"
msgstr "Twitter- / X-Seiten-Handle"

msgid "Optional site account for &lt;meta name=\"twitter:site\"&gt;."
msgstr "Optionaler Website-Account für &lt;meta name=\"twitter:site\"&gt;."

msgid "Fediverse / Mastodon handle"
msgstr "Fediverse- / Mastodon-Handle"

msgid "Default handle for &lt;meta name=\"fediverse:creator\"&gt;. Authors can also set their own handle in their user profile."
msgstr "Standard-Handle für &lt;meta name=\"fediverse:creator\"&gt;. Autorinnen und Autoren können ihr eigenes Handle in ihrem Benutzerprofil hinterlegen."

msgid "Post types"
msgstr "Inhaltstypen"

msgid "Can also be filtered via the metatags_post_types hook."
msgstr "Kann auch über den Filter metatags_post_types angepasst werden."

msgid "Archive meta tags"
msgstr "Archiv-Meta-Tags"

msgid "Output description, Open Graph and Twitter Card tags on category, tag, taxonomy, author and post type archives."
msgstr "Beschreibung, Open-Graph- und Twitter-Card-Tags auf Kategorie-, Schlagwort-, Taxonomie-, Autoren- und Inhaltstyp-Archiven ausgeben."

msgid "Noindex search results"
msgstr "Suchergebnisse nicht indexieren"

msgid "Add noindex to search result pages."
msgstr "Suchergebnisseiten mit noindex auszeichnen."

msgid "Noindex author archives"
msgstr "Autorenarchive nicht indexieren"

msgid "Add noindex to author archives and exclude users from the XML sitemap."
msgstr "Autorenarchive mit noindex auszeichnen und Benutzer aus der XML-Sitemap ausschließen."

msgid "Noindex tag archives"
msgstr "Schlagwort-Archive nicht indexieren"

msgid "Add noindex to tag archives and exclude tags from the XML sitemap."
msgstr "Schlagwort-Archive mit noindex auszeichnen und Schlagwörter aus der XML-Sitemap ausschließen."

msgid "Noindex date archives"
msgstr "Datumsarchive nicht indexieren"

msgid "Add noindex to date archives."
msgstr "Datumsarchive mit noindex auszeichnen."

msgid "Meta Tags detected another active SEO plugin (%s). Consider disabling overlapping tag groups under Settings → Meta Tags to avoid duplicate meta tags."
msgstr "Meta Tags hat ein anderes aktives SEO-Plugin erkannt (%s). Deaktivieren Sie unter Einstellungen → Meta Tags die sich überschneidenden Tag-Gruppen, um doppelte Meta-Tags zu vermeiden."

msgid "Meta Tags is maintained by Nick Weschkalnies – freelance web designer & developer for agencies and direct clients."
msgstr "Meta Tags wird entwickelt von Nick Weschkalnies – freier Webdesigner & Entwickler für Agenturen und Endkunden."

msgid "Buy me a coffee"
msgstr "Kaffee spendieren"

msgid "Settings"
msgstr "Einstellungen"
