{
	"name": "weschkalnies/wordpress-metatags",
	"description": "Lightweight per-post meta tags, Open Graph, Twitter Card and Schema.org JSON-LD for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpstan/phpstan": "^2.0",
		"phpunit/phpunit": "^9.6 || ^10.5 || ^11.0",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --no-progress --memory-limit=512M",
		"test": "phpunit",
		"check": [
			"@lint",
			"@analyse",
			"@test"
		]
	}
}
